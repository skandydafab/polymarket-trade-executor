# ==================================================================
# PolyymarketExecutor environment template
# ------------------------------------------------------------------
# IMPORTANT:
# - Values below are illustrative examples only.
# - Replace ALL credential-like fields before live usage.
# - Keep this file committed; keep your real .env uncommitted.
# ==================================================================

# ----------------------------
# Polymarket venue configuration
# Maps to executor.polymarket_adapter.PolymarketAdapterConfig
# ----------------------------

# Venue host URL
POLYMARKET_API_URL=https://clob.polymarket.com

# Example EVM private key format (0x + 64 hex chars)
POLYMARKET_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional API auth fields (examples only)
POLYMARKET_API_KEY=pm_api_key_example_123456
POLYMARKET_API_SECRET=pm_api_secret_example_abcdef
POLYMARKET_PASSPHRASE=pm_passphrase_example

# Polygon mainnet is typically 137
POLYMARKET_CHAIN_ID=137

# Signature type depends on account setup; examples: 0 or 1
POLYMARKET_SIGNATURE_TYPE=0

# Optional wallet addresses for signer context (40 hex chars + 0x prefix)
POLYMARKET_FUNDER=0x1111111111111111111111111111111111111111
POLYMARKET_MAKER=0x2222222222222222222222222222222222222222

# Enable SDK-backed signer helper in live mode
POLYMARKET_USE_SDK_SIGNER=true

# Venue adapter timeouts and polling
POLYMARKET_SUBMIT_TIMEOUT_MS=500
POLYMARKET_CANCEL_TIMEOUT_MS=500
POLYMARKET_POLL_TIMEOUT_MS=700
POLYMARKET_POLL_BATCH_LIMIT=200

# Optional upstream subscription scope (comma-separated).
# These are parsed by examples/run_executor_from_env.py and intended
# to be handed to your market-data collector/detector layer.
POLYMARKET_SUBSCRIBE_MARKET_IDS=0xmarket_condition_id_example_a,0xmarket_condition_id_example_b
POLYMARKET_SUBSCRIBE_TOKEN_IDS=1234567890123456789012345678901234567890,9876543210987654321098765432109876543210

# Client order id format settings
POLYMARKET_CLIENT_ORDER_ID_PREFIX=pmx
POLYMARKET_CLIENT_ORDER_ID_MAX_LENGTH=96

# ----------------------------
# Optional HTTP client tuning
# Maps to executor.polymarket_clob_client.PolymarketCLOBHttpClientConfig
# ----------------------------
POLYMARKET_HTTP_REQUEST_TIMEOUT_MS=1500
POLYMARKET_UPDATES_MAX_RETRIES=3
POLYMARKET_UPDATES_RETRY_BASE_MS=100
POLYMARKET_SUBMIT_PATH=/order
POLYMARKET_CANCEL_PATH=/cancel
POLYMARKET_UPDATES_PATH=/orders/updates
POLYMARKET_OPEN_ORDERS_PATH=/orders/open

# ----------------------------
# Executor service configuration
# Maps to executor.executor_service.ExecutorServiceConfig
# ----------------------------
EXECUTOR_SERVICE_NAME=executor-live
EXECUTOR_CLIENT_ORDER_ID_PREFIX=exec
EXECUTOR_CLIENT_ORDER_ID_MAX_LENGTH=96
EXECUTOR_DEFAULT_LEG_TIMEOUT_MS=800
EXECUTOR_POLL_VENUE_UPDATES_ON_TICK=true
EXECUTOR_MAX_CONTROL_ACTIONS_PER_TICK=128
EXECUTOR_MAX_CONTROL_QUEUE_SIZE=10000
EXECUTOR_AUTO_CANCEL_ON_TIMEOUT=true
EXECUTOR_AUTO_CANCEL_ON_ABORT=true
EXECUTOR_HALT_AFTER_RECOVERY_WITH_ACTIVE_PACKAGES=true
EXECUTOR_JOURNAL_ERRORS_HALT_TRADING=false

# ----------------------------
# Journal + mode controls
# ----------------------------
EXECUTOR_JOURNAL_DIR=./data/journal

# Safety default: false. Set true only when ready for live traffic.
EXECUTOR_LIVE_TRADING_ENABLED=false

# Optional startup reconciliation/recovery
EXECUTOR_RUN_RECOVERY_ON_START=false
